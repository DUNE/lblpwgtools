#include "FitChannels.fcl"
#include "RunPlans.fcl"
#include "ScanDefinitions.fcl"
#include "NuisanceParameters.fcl"

BasicPred: {

	output_file: ["/home/vol06/scarf1206/PRISM_Thesis/PRISMScans/MPFDResults/Dmsq32_Ssth23_ELepEHadParam_100_NDEffBias_MPFD_26May23/PRISMScan_dmsq32_ssth23.root", "UPDATE"]
	
	#output_file: ["prism_oscfit_ssth23_v3r5p10-37-g0f2b8dc_HornCEccentricityInducedBField_OffAxis2026-amc1.root", "UPDATE"]
	#output_file: ["prism_oscfit_dmsq32_v3r5p10-37-g0f2b8dc_HornCEccentricityInducedBField_OffAxis2026-amc1.root", "UPDATE"]
	
	#output_file: ["prism_oscfit_ssth23_v3r5p10-37-g0f2b8dc_HornCEllipticityInducedBField_OffAxis2026-amc1.root", "UPDATE"]
	#output_file: ["prism_oscfit_dmsq32_v3r5p10-37-g0f2b8dc_HornCEllipticityInducedBField_OffAxis2026-amc1.root", "UPDATE"]
	
	#output_file: ["prism_oscfit_ssth23_v3r5p10-37-g0f2b8dc_nom_OffAxis2026-amc1.root", "UPDATE"]
	#output_file: ["prism_oscfit_dmsq32_v3r5p10-37-g0f2b8dc_nom_OffAxis2026-amc1.root", "UPDATE"]

	#state_file: "/home/vol06/scarf1206/PRISM_Thesis/PRISMStateFiles/PRISMState_ELepEHadParam_EffBias_4Flav_TrueLepCoarseHad_13Jun23.root"
	#state_file:"/exp/dune/data/users/yuribae/prism/state/PRISMStateFile_EnuReco_NewFluxSystSep21_AllFocusingPars.root"
	#state_file: "/exp/dune/data/users/yuribae/prism/state/prism_state_v3r5p10-37-g0f2b8dc_HornDeformInducedBField_OffAxis2026.root"
	
	# Analysis variable name - must match variable in state file
	projection_name: EnuReco # ELepEHad_param, ETrue, etc.
	
	# Set exposure in years
	POT_years: 7 # 2.084 # 1.042 for 100 MWktYrs, 7 for 336 MWktYrs
	POT_staging: nostage
	
	# Use ND stat covariance in fitting? Typically true for full PRISM stat error
	use_ND_stats: true
	
	# Definitely want this to be false for fits!
	vary_NDFD_data: false
        
	# Extra plots for more histograms in PRISMPrediction
	# Should be false for fitting
	prism_debugplots: false
	
	# Do you want to use fake data?
	use_fake_data: false
	
	# True to include FD intrinsic nue in flux match
	match_intrinsic_nue: true
	
	# True to include FD Wron Sign background on a data-driven approach
    match_ws: false
	
	# Do you want the reactor th13 constraint?
	reactor_constraint: true
	
	# Regularisation parameter for unfolding - greater stability in fits
	#unfold_reg_param: 0.003 # default is 0.0001

	# Add "final" NDFD residual MC Correction
	apply_MC_correction: true

	PRISM: {
		match_conditioning: [
			{
			chan: @local::FitChannels.Numu_disp
			energy_range: [0.5, 6]
			reg_factor_293kA: 5.6E-17
			reg_factor_280kA: 1E-18
			},
			{
			chan: @local::FitChannels.Numubar_disp
			energy_range: [0.5, 6]
			reg_factor_293kA: 1.9E-17
			reg_factor_280kA: 1E-18
			},
			{
			chan: @local::FitChannels.Nue_app
			energy_range: [0.5, 5]
			reg_factor_293kA: 3.4E-17
			reg_factor_280kA: 1E-18
			},
			{
			chan: @local::FitChannels.Nuebar_app
			energy_range: [0.5, 5]
			reg_factor_293kA: 9.9E-18
			reg_factor_280kA: 1E-18
			},
			{
			chan: @local::FitChannels.Nutau_app
			energy_range: [3.35, 10]
			reg_factor_293kA: 2.5E-17
			reg_factor_280kA: 1E-18
			},
			{
			chan: @local::FitChannels.Nutaubar_app
			energy_range: [3.35, 10]
			reg_factor_293kA: 2.5E-17
			reg_factor_280kA: 1E-18
			}
		]
		# Will probably want this to be true - set ND errors from sqrt(N)
		set_ND_errors_from_rate: true

		RunPlans: {
			#numode: @local::RunPlans.guess_fine
			#nubmode: @local::RunPlans.guess_fine
			numode: @local::RunPlans.guess
			nubmode: @local::RunPlans.guess
		}
		# Almost always true for now
		Use_EventRateMatching: true
	}

	# Oscillation parameters to include in fit
	free_osc_params: [dmsq32, ssth23, ss2th13, deltapi, dmsq21, ssth12, rho]
	
	# Parameter(s) to scan over in fit
	#scan_params: @local::ScanDefinitions.ssth23_dmsq32
	#scan_params: @local::ScanDefinitions.dcp_ss2th13
	#scan_params: @local::ScanDefinitions.dmsq32
	scan_params: @local::ScanDefinitions.ssth23
	
	# Number of samples to include
	samples: @local::JointFitChannels.FourFlavor
}

scans: [
#	{
#		@table::BasicPred
#		#output_dir: "fit_mpfd_100"
#	}

	{
		@table::BasicPred
		#free_syst_params: @local::nuisance_parameter_sets.fluxSept21_0
		#free_syst_params: @local::nuisance_parameter_sets.fluxSept21_1
		output_dir: "fit_nom"
		#output_dir: "fit_flux_Sept21_0_HornAEccentricityInducedBField"
		#output_dir: "fit_flux_Sept21_1_HornAEllipticityInducedBField"
	}
]

# This means that it overwrites the outputfile for the first scan and then appends subsequent scans.
scans[0].output_file[1]: "RECREATE"
